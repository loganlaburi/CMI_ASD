## Regression Graph 
model <- lm(SCARED_P_SP ~ hhi + SDS_DA_T + SDS_DIMS_T +
              SDS_SBD_T + SDS_SWDT_T, data = early)

# Create new data for prediction of specific variable while controlling other variable
new_data <- data.frame(
  hhi    = mean(early$hhi, na.rm = TRUE),
  SDS_DIMS_T    = mean(early$SDS_DIMS_T, na.rm = TRUE),
  SDS_DA_T    = mean(early$SDS_DA_T, na.rm = TRUE),
  SDS_SWDT_T    = mean(early$SDS_SWDT_T, na.rm = TRUE),
  SDS_SBD_T  = seq(min(early$SDS_SBD_T, na.rm = TRUE),
                    max(early$SDS_SBD_T, na.rm = TRUE),
                    length.out = 100)
)

# Predict with confidence intervals
pred <- predict(model, newdata = new_data, interval = "confidence")
pred_df <- cbind(new_data, pred)

# Plot it into line graph (95% confidence interval) 
ggplot() +
  # Original data points
  geom_point(data = early, aes(x = SDS_SBD_T, y = SCARED_P_SP), color = "gray", 
             alpha = 0.6) +
  # Prediction line
  geom_line(data = pred_df, aes(x = SDS_SBD_T, y = fit), color = "#1a5050", 
            size = 1) +
  # Confidence interval ribbon
  geom_ribbon(data = pred_df, aes(x = SDS_SBD_T, ymin = lwr, ymax = upr), 
