# 4. Function to run MANCOVA for a given covariate
run_manova <- function(dvs, group_var, data) {
  # Ensure group variable is a factor
  data[[group_var]] <- as.factor(data[[group_var]])
  
  # Create formula for MANOVA
  formula_text <- paste("cbind(", paste(dvs, collapse = ", "), ") ~", group_var)
  formula <- as.formula(formula_text)
  
  # Run MANOVA
  manova_model <- manova(formula, data = data)
  
  # Wilks' Lambda test
  summary_results <- summary(manova_model, test = "Wilks")
  print(summary_results)
  
  return(manova_model)
}

