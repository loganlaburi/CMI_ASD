# Function post hoc
run_posthoc <- function(dv, data) {
  # Remove rows with NA in group or DV
  clean_data <- data %>%
    filter(!is.na(age_group), !is.na(.data[[dv]])) %>%
    mutate(group = as.character(as.integer(age_group)))  # Ensure group is character
  
  # Fit ANOVA model
  formula <- as.formula(paste(dv, "~ age_group"))
  model <- lm(formula, data = clean_data)
  
  # Estimated marginal means
  emms <- emmeans(model, ~ age_group)
  emms_df <- as.data.frame(summary(emms))
  emms_df$DV <- dv
  
  # Tukey post hoc comparisons
  posthoc <- pairs(emms, adjust = "tukey")
  posthoc_df <- as.data.frame(summary(posthoc))
  posthoc_df$DV <- dv
  
  # Separate contrast into group1 and group2
  posthoc_df <- posthoc_df %>%
    separate(contrast, into = c("group1", "group2"), sep = " - ", remove = FALSE) %>%
    mutate(group1 = trimws(as.character(group1)),
           group2 = trimws(as.character(group2)))
  
  # Group-wise mean and SD
  group_stats <- clean_data %>%
    group_by(age_group) %>%
    summarise(
      Mean = mean(.data[[dv]], na.rm = TRUE),
      SD = sd(.data[[dv]], na.rm = TRUE),
      .groups = "drop"
    )
  
  posthoc_df <- posthoc_df %>%
    separate(contrast, into = c("group1", "group2"), sep = " - ", remove = FALSE) %>%
    mutate(
      group1 = trimws(as.character(gsub("group", "", group1))),
      group2 = trimws(as.character(gsub("group", "", group2)))
    )
  
  # Join group stats
  posthoc_df <- posthoc_df %>%
    left_join(group_stats %>% rename(group1 = age_group, Mean1 = Mean, SD1 = SD), 
              by = "group1") %>%
    left_join(group_stats %>% rename(group2 = age_group, Mean2 = Mean, SD2 = SD), 
              by = "group2")
  
  # Return results
  list(
    EMMs_df = emms_df,
    PostHoc_df = posthoc_df
  )
}

# Run post hoc test
posthoc_scared <- lapply(SCARED, function(dv) run_posthoc(dv, data))
posthoc_cbcl <- lapply(CBCL, function(dv) run_posthoc(dv, data))
posthoc_sds <- lapply(SDS, function(dv) run_posthoc(dv, data))

# Combine all post hoc results
combined_posthoc <- bind_rows(
  lapply(posthoc_scared, function(x) x$PostHoc_df),
  lapply(posthoc_cbcl, function(x) x$PostHoc_df),
  lapply(posthoc_sds, function(x) x$PostHoc_df)
)

